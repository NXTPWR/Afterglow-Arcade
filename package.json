{
  "name": "afterglow-arcade",
  "version": "1.0.0",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.afterglow.arcade",
    "productName": "Afterglow Arcade",
    "files": [
      "src/**/*",
      "index.html",
      "styles.css",
      "game.js",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "description": "Six focused mini-games in a premium Windows desktop arcade",
  "author": "Afterglow Arcade"
}