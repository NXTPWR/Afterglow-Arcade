{
  "name": "afterglow-arcade",
  "version": "1.1.0",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test",
    "qa": "electron ."
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.afterglow.arcade",
    "productName": "Afterglow Arcade Club",
    "files": [
      "assets/**/*",
      "game-core.js",
      "game.js",
      "index.html",
      "src/**/*",
      "styles.css",
      "website/firebase-client.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "electronDist": "node_modules/electron/dist",
    "artifactName": "Afterglow-Arcade-Club-Setup.${ext}"
  },
  "description": "Six focused mini-games in a premium Windows desktop arcade",
  "author": "Afterglow Arcade"
}
